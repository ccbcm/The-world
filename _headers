/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/main.js
  Cache-Control: public, max-age=0, must-revalidate

/character.js
  Cache-Control: public, max-age=0, must-revalidate


/architecture.js
  Cache-Control: public, max-age=0, must-revalidate

/gallery/*
  Cache-Control: public, max-age=0, must-revalidate

/city.html
  Cache-Control: public, max-age=0, must-revalidate

/downloads/*
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
